# Copy to .env and fill in. Never commit .env.
RPC_API_KEY=
TELEGRAM_BOT_TOKEN=
# LLM for testing (the templates' default): NVIDIA API catalog, OpenAI-compatible
# (https://integrate.api.nvidia.com/v1, model meta/muse-glimmer-30b). Key from build.nvidia.com.
NVIDIA_API_KEY=
# Alternative: Gemini's OpenAI-compatible endpoint (free tier: 20 requests/day per model).
# Use with: syndromi run <dir> --model gemini:gemini-3.8-flash
GEMINI_API_KEY=
# Optional: Anthropic BYOK provider (--model anthropic:claude-sonnet-5)
ANTHROPIC_API_KEY=
# Optional: Jupiter Swap API key (https://developers.jup.ag/portal). Keyless works at low rate limits.
JUPITER_API_KEY=
# Optional: Pyth Hermes API key (https://pythdata.app/signup). When set, USD prices come from
# Pyth first, falling back to the keyless Jupiter Price API per request (so an expired trial
# key degrades to Jupiter instead of "no price").
PYTH_API_KEY=
# Approvals server (pnpm server). The CLI uses the same token to talk to it.
# Generate one with: openssl rand -hex 24
SYNDROMI_SERVER_TOKEN=
# Where wallets reach the Actions endpoints and the approve page (default http://127.0.0.1:8787;
# Telegram rejects "localhost" in button URLs). BLINK_VIEWER=dialto sends dial.to links instead.
PUBLIC_URL=
BLINK_VIEWER=
# Hosted agents: their keys are stored encrypted with this secret (32+ characters).
# Generate one with: openssl rand -hex 32
SYNDROMI_HOSTED_SECRET=
# Dashboard origins allowed to call the server (default http://localhost:3000,http://127.0.0.1:3000).
DASHBOARD_ORIGINS=
# Dashboard (apps/dashboard): where it finds the server (default http://127.0.0.1:8787).
NEXT_PUBLIC_SYNDROMI_SERVER=
# Hosted agents run on their manifest cron; set to off so they only run on "Run now" (demos).
SYNDROMI_HOSTED_SCHEDULE=
